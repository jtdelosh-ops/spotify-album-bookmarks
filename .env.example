# Documentation template. Copy to .dev.vars for Wrangler local development.
# Production uses Wrangler secrets for ENCRYPTION_KEY and SETUP_KEY.
APP_ORIGIN="http://127.0.0.1:8787"
SPOTIFY_CLIENT_ID="your-public-client-id"
# Generate a 32-byte base64 encryption key with the command in README.
ENCRYPTION_KEY="replace-with-base64-key"
# Generate a separate 32-byte base64url setup key. Keep it private.
SETUP_KEY="replace-with-random-setup-key"
