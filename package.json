{
  "name": "spotify-album-bookmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir .build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
