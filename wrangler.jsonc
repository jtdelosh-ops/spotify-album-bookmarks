{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotify-album-bookmarks",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{
    "binding": "DB", "database_name": "spotify-album-bookmarks",
    "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"
  }],
  "vars": { "APP_ORIGIN": "http://127.0.0.1:8787", "SPOTIFY_CLIENT_ID": "REPLACE_WITH_YOUR_CLIENT_ID" },
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": false }
}
